# Copy this file to .env and fill in your own keys.
# .env is gitignored -- never commit real keys.

# Groq API key, used for generating location-aware treatment plans.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Yesterday/today/tomorrow weather for the treatment plan comes from
# Open-Meteo (https://open-meteo.com/en/docs), which is free and keyless
# for non-commercial use -- no key needed here.
